{
  "name": "paymongo-fn",
  "description": "Transport-agnostic PayMongo SDK with Zod schemas. Bring your own HTTP client or use the built-in fetch client.",
  "keywords": [
    "paymongo",
    "sdk",
    "zod",
    "fetch",
    "typescript"
  ],
  "author": "xpriori",
  "version": "0.2.0",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bunchee -o ./lib/index.js",
    "dev": "bunchee -w --no-clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "prepublishOnly": "bun run typecheck && bun run lint && bun run build"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.11.0",
    "@types/bun": "latest",
    "@types/eslint": "^9.6.1",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "bunchee": "^5.4.0",
    "eslint": "^9.11.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "license": "MIT",
  "directories": {
    "lib": "lib"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/phtn/paymongo-fn.git"
  },
  "bugs": {
    "url": "https://github.com/phtn/paymongo-fn/issues"
  },
  "homepage": "https://github.com/phtn/paymongo-fn#readme"
}