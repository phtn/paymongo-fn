{
  "compilerOptions": {
    // Enable latest features
    "lib": [
      "ESNext",
      "DOM"
    ],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "allowJs": false,
    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "declaration": true,
    "outDir": "./lib",
    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "baseUrl": "src",
    "paths": {
      "@schema/*": [
        "./schema/*"
      ],
      "@sdk/*": [
        "./sdk/*"
      ]
    }
  },
  "include": [
    "src/index.ts",
    "src/http/**/*.ts",
    "src/sdk/**/*.ts",
    "src/schema/**/*.ts"
  ],
  "exclude": [
    "src/trpc/**",
    "src/utils/**",
    "src/callers/**",
    "src/sdk/axios-instance.ts",
    "eslint.config.mjs",
    "trpc/**",
    "utils/**",
    "callers/**"
  ]
}